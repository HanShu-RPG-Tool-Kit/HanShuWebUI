{
  "format": "hanshu.bossbar",
  "version": 2,
  "id": "hanshu:simple_bar",
  "priority": 0,
  "texture": "",
  "layout": {
    "dock": "top-center",
    "scale": 1,
    "safeMargin": 12
  },
  "variables": {
    "healthProgress": {
      "type": "double",
      "default": 0.65
    },
    "healthText": {
      "type": "string",
      "default": "65 / 100",
      "maxLength": 64
    }
  },
  "components": [
    {
      "id": "region",
      "type": "display_region",
      "box": {
        "x": 0,
        "y": 0,
        "width": 320,
        "height": 24
      }
    },
    {
      "id": "track",
      "type": "background",
      "box": {
        "x": 0,
        "y": 0,
        "width": 320,
        "height": 24
      },
      "visible": true,
      "opacity": 1,
      "paint": {
        "kind": "texture",
        "uv": {
          "x": 0,
          "y": 0,
          "width": 64,
          "height": 16
        },
        "fit": "stretch"
      }
    },
    {
      "id": "fill",
      "type": "bar",
      "box": {
        "x": 2,
        "y": 2,
        "width": 316,
        "height": 20
      },
      "visible": true,
      "opacity": 1,
      "progress": {
        "var": "healthProgress"
      },
      "direction": "left-to-right",
      "fill": {
        "kind": "texture",
        "uv": {
          "x": 64,
          "y": 0,
          "width": 192,
          "height": 16
        },
        "fit": "stretch"
      },
      "smoothMs": 120
    },
    {
      "id": "label",
      "type": "text",
      "box": {
        "x": 0,
        "y": 0,
        "width": 320,
        "height": 24
      },
      "visible": true,
      "opacity": 1,
      "runs": [
        {
          "var": "healthText"
        }
      ],
      "fontSize": 14,
      "color": "#FFFFFFFF",
      "align": "center",
      "verticalAlign": "middle",
      "shadow": true
    }
  ]
}
