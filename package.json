{
  "name": "hanshu",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "check:hs": "esbuild scripts/check-hanshu-coloring.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/check-hanshu-coloring.cjs --log-level=warning && node node_modules/.cache/check-hanshu-coloring.cjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "test:skin-codec": "tsx scripts/verify-skin-codec.ts",
    "test:progress": "tsx scripts/verify-progress-model.ts",
    "test:tts": "npm run test:tts-net && npm run test:tts-protocols && npm run test:tts-voices",
    "test:tts-net": "tsx scripts/verify-tts-net.ts",
    "test:tts-protocols": "tsx scripts/verify-tts-protocols.ts",
    "test:tts-voices": "tsx scripts/verify-tts-voices.ts"
  },
  "dependencies": {
    "@audio/encode-ogg": "^1.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "dompurify": "^3.4.15",
    "jszip": "^3.10.2",
    "marked": "^18.0.14",
    "pako": "^3.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "skinview3d": "^3.4.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/dompurify": "^3.0.5",
    "@types/jszip": "^3.4.0",
    "@types/node": "^24.13.3",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
