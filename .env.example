# DeepSeek Agent（复制本文件为 .env 后填写）

# 必填：https://platform.deepseek.com
VITE_DEEPSEEK_API_KEY=sk-your-key-here

# 可选
VITE_DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型请在网页 Agent 顶栏用 Pro 开关切换（开=v4-pro，关=flash）
# VITE_DEEPSEEK_MODEL 仅影响「从未点过开关」时的默认倾向

# 温度 0～2：剧本助手建议 0.2～0.5
VITE_DEEPSEEK_TEMPERATURE=0.3
